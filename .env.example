# Copy this file to .env and adjust for your machine.
# Base URL of the Flask backend. In dev, Vite proxies /api to this target
# (see vite.config.js), so VITE_API_BASE_URL is mainly used for documentation
# and for the proxy target — components should always call relative "/api/..."
# paths through src/services/api.js, never this variable directly.
VITE_API_BASE_URL=http://localhost:5000
